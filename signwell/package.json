{
  "name": "signwell-launch",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio",
    "stills": "node scripts/stills.mjs",
    "render": "remotion render Launch out/signwell_launch_1920x1080.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "render:vertical": "remotion render LaunchVertical out/signwell_launch_1080x1920.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "render:square": "remotion render LaunchSquare out/signwell_launch_1080x1080.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "soundtrack": "python3 scripts/soundtrack.py"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.242",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.242"
  }
}